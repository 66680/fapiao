          }
        }
      }
    },
    "/v1/export/preview": {
      "post": {
        "tags": [
          "export"
        ],
        "summary": "Preview mapped export rows",
        "description": "Upload records.jsonl and preview mapped export rows using template_id or inline template_yaml.",
