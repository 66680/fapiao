            "type": "string",
            "title": "Template Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "columns": {
            "type": "integer",
            "title": "Columns"
          }
        },
        "type": "object",
        "required": [
          "template_id",
          "version",
          "columns"
        ],
        "title": "ExportTemplateMeta"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
