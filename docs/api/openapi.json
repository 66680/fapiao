  "components": {
    "schemas": {
      "BatchSubmitResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "BatchSubmitResponse"
      },
      "Body_batch_parse_v1_batch_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "format": "binary"
            },
            "type": "array",
            "title": "Files",
            "description": "Files to parse"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_batch_parse_v1_batch_post"
      },
      "Body_export_preview_v1_export_preview_post": {
        "properties": {
          "records": {
            "type": "string",
            "format": "binary",
            "title": "Records",
            "description": "records.jsonl file"
          },
          "template_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Template Id"
          },
          "template_yaml": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
