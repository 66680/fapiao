      "ExportPreviewStats": {
        "properties": {
          "input_rows": {
            "type": "integer",
            "title": "Input Rows"
          },
          "preview_rows": {
            "type": "integer",
            "title": "Preview Rows"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "fallback_usage_by_column": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Fallback Usage By Column"
          },
          "source_usage_by_column": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Source Usage By Column"
          },
          "invalid_rows": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invalid Rows"
          },
          "has_more": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has More"
          },
          "total_records": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Records"
          }
        },
        "type": "object",
        "required": [
          "input_rows",
          "preview_rows",
          "truncated"
        ],
        "title": "ExportPreviewStats"
