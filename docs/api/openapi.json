            "title": "Template Yaml"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "Body_export_preview_v1_export_preview_post"
      },
      "Body_parse_v1_parse_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "Single JPG/PNG/PDF file"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_parse_v1_parse_post"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "E1001",
          "E2001",
          "E3001",
          "E3002",
          "E4001",
          "E5001"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "trace_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "ExportPreviewResponse": {
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          },
          "stats": {
            "$ref": "#/components/schemas/ExportPreviewStats"
          },
          "template_id": {
            "type": "string",
            "title": "Template Id"
          },
          "job_id": {
            "anyOf": [
